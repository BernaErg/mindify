# Copy to .env for local use, and set the same two values in
# Netlify → Site configuration → Environment variables.
#
# Both of these are safe to expose in the browser. The anon key is a *public*
# key; row-level security in Supabase is what actually protects the data.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
CONTACT_EMAIL=hello@mindify.co.uk
